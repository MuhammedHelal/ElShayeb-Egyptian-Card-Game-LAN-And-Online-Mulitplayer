{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elshayeb-online",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "vars": {
    "SUPABASE_URL": "https://cusfjqfiurvekppweuaq.supabase.co"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
